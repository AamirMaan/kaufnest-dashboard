# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template itself — this SHOULD be committed (every SKILL.md/
# README references it as the checked-in setup guide, but `.env*` above was
# silently swallowing it too, so it was never actually in git history).
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.superpowers/

graphify-out/cost.json        # local only
# Content-hashed AST cache. Was optional ("commit for speed") while `graphify
# update` was run by hand; now that refresh_graphify.py rebuilds on every
# code-touching turn, committing it would add churn to nearly every diff and
# grow without bound. graph.json itself stays tracked — that's the artifact
# worth sharing.
#
# NOTE: this only stops *new* cache files. The ones already committed stay
# tracked (gitignore does not apply to tracked files) and will keep showing up
# as modified. To finish the job:  git rm -r --cached graphify-out/cache/
graphify-out/cache/

# Playwright E2E — saved auth state (contains real session tokens)
e2e/.auth/
.worktrees/

# Doc-drift hook scratch state — regenerated every session, never shared
.claude/claude-md-review.md
.claude/.claude_md_review_fingerprint
.claude/hooks/__pycache__/
.claude/verifiers/__pycache__/

# Graphify rebuild lock — per-machine, held only while a rebuild is running
graphify-out/.refresh.lock
