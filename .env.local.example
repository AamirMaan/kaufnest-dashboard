# Copy this file to .env.local and fill in your Supabase project credentials
# Find these in: https://app.supabase.com -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key for the SAME project as NEXT_PUBLIC_SUPABASE_URL above
# ("Project B" / data plane) — bypasses RLS. Server-only, used by
# createServiceClientForTenant() (src/lib/supabase/server.ts) for
# tenant-schema-scoped admin operations (provisioning, invites, impersonation,
# the eBay account-deletion webhook's cleanup, the token-encryption backfill
# script). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-data-plane-service-role-key

# Personal access token for the Supabase Management API
# (https://supabase.com/dashboard/account/tokens). Server-only — used by
# /api/admin/provision-tenant to add new tenant schemas to Project B's
# "Exposed schemas" setting automatically (see src/lib/supabase/managementApi.ts).
SUPABASE_ACCESS_TOKEN=your-management-api-token

# Public base URL this app is served from (no trailing slash) — used to build
# absolute redirect URLs (OAuth callbacks, the invite/set-password email link,
# the eBay account-deletion webhook's registered endpoint URL) where a
# relative URL or req.url would resolve to an internal/proxy hostname instead
# of the real public one.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ─── Control plane (Project A — src/lib/supabase/control.ts) ────────────────

# A SEPARATE Supabase project from the one above — tracks tenants
# (control.tenants) and KaufNest platform staff (control.admin_users). See
# supabase/control-plane/*.sql and SAAS_MIGRATION.md Phase 1.
CONTROL_SUPABASE_URL=https://your-control-plane-project-id.supabase.co
CONTROL_SUPABASE_SERVICE_KEY=your-control-plane-service-role-key

# ─── Stripe billing (src/lib/stripe.ts, src/app/api/billing/) ───────────────

STRIPE_SECRET_KEY=your-stripe-secret-key
# From the Stripe Dashboard's webhook endpoint config (or `stripe listen` for
# local dev) — verifies /api/billing/webhook request signatures.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# From `npm run stripe:setup` (scripts/stripe-setup.mjs) — one Price ID per
# plan. Test-mode and live-mode values differ; re-run the script in live
# mode when going to production.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ─── Platform integrations (src/lib/integrations/) ──────────────────────────

# AES-256-GCM key encrypting stored OAuth access/refresh tokens
# (platform_connections.access_token/refresh_token — see tokenCrypto.ts).
# Generate with: openssl rand -base64 32
# Required in every environment that reads/writes platform_connections
# (local dev + every deployed environment) once you've connected an
# integration — losing this key makes existing stored tokens unrecoverable
# (users would need to reconnect eBay/Amazon).
TOKEN_ENCRYPTION_KEY=run-openssl-rand-base64-32-and-paste-the-output-here

# eBay developer app (https://developer.ebay.com/my/keys). EBAY_RU_NAME is the
# "RuName" redirect identifier from the same page — eBay's OAuth flow requires
# this instead of a raw redirect URL.
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_RU_NAME=your-ebay-runame

# Verification token for eBay's Marketplace Account Deletion notification
# endpoint (src/app/api/notifications/ebay-account-deletion/route.ts) — set
# the SAME value here and in the endpoint's config on the eBay Developer
# Portal's Notifications page. Used only for the GET challenge-response at
# endpoint registration; the actual POST notifications are authenticated
# separately via eBay's signed X-EBAY-SIGNATURE header (verified using
# EBAY_CLIENT_ID/EBAY_CLIENT_SECRET above, no extra secret needed for that).
EBAY_VERIFICATION_TOKEN=a-long-random-string-you-choose

# Set to "true" to hit api.sandbox.ebay.com / auth.sandbox.ebay.com instead of
# production endpoints, across every eBay integration (OAuth, orders,
# listings publish, the account-deletion webhook's public-key fetch).
EBAY_SANDBOX=false

# Optional overrides for the Listings feature's publish flow
# (src/lib/integrations/ebay/publish.ts) — sensible defaults are baked in,
# only set these if yours differ.
# EBAY_MARKETPLACE_ID=EBAY_DE
# EBAY_CATEGORY_TREE_ID=77
# Merchant location is no longer a global env var — each tenant picks their
# own inventory location per-draft in the listing wizard (fetched live from
# their eBay account, see dashboard/listings/SKILL.md).

# Login with Amazon credentials for your SP-API app (Seller Central →
# Partner Network → Develop Apps → View credentials). Used for exchanging and
# refreshing SP-API access tokens.
AMAZON_LWA_CLIENT_ID=your-amazon-lwa-client-id
AMAZON_LWA_CLIENT_SECRET=your-amazon-lwa-client-secret

# SP-API *application id* (amzn1.sellerapps.app…) from the same Develop Apps
# page — this goes on the OAuth consent URL and is NOT the LWA client id.
AMAZON_APP_ID=your-amazon-sp-api-application-id

# Set to "true" while the SP-API app is in Draft status in Seller Central —
# adds version=beta to the consent URL, which draft apps require.
AMAZON_APP_IS_DRAFT=true

# Public base URL of this app — used to build the Amazon OAuth redirect URI
# (${NEXT_PUBLIC_APP_URL}/api/integrations/amazon/callback). Must be HTTPS and
# registered as an OAuth Redirect URI on the SP-API app. Also used by billing.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Optional overrides — defaults target the EU endpoint and Amazon.de.
# AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# AMAZON_DEFAULT_MARKETPLACE_ID=A1PA6795UKMFR9

# ─── Playwright E2E (e2e/) ───────────────────────────────────────────────────

# Dedicated admin test user for Playwright E2E — create in the live tenant_kaufnest.
# This user must have super_admin role so tests can delete records for cleanup.
E2E_EMAIL=your-test-user@example.com
E2E_PASSWORD=your-test-user-password
